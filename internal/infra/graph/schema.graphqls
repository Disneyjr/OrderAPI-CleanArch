type Order {
    id: String!
    Price: Float!
    Tax: Float!
    FinalPrice: Float!
}

input OrderInput {
    id : String!
    Price: Float!
    Tax: Float!
}

type Query {
    ListOrders: [Order!]!
    listOrders: [Order!]!
    orders: [Order!]!
}

type Mutation {
    createOrder(input: OrderInput): Order
}